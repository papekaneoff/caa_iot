# .env.example — Copy to .env and fill in your values
# ⚠️  NEVER commit .env to git — it's in .gitignore

# ── Google Cloud (shared with the whole team) ─────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west1
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# ── BigQuery (match your teammates' table names) ──────────────────────────────
BIGQUERY_DATASET=weather_monitor
BIGQUERY_TABLE=sensor_data

# ── OpenWeatherMap ────────────────────────────────────────────────────────────
OPENWEATHERMAP_API_KEY=your-owm-key-here
LOCATION_ZIP=1000
LOCATION_COUNTRY=CH

# ── WiFi (for M5Stack device) ─────────────────────────────────────────────────
WIFI_SSID=your-wifi-name
WIFI_PASSWORD=your-wifi-password

# ── Fallback LLM (only if Vertex AI unavailable) ──────────────────────────────
OPENAI_API_KEY=sk-...   # optional
